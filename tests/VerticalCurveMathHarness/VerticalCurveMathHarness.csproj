<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- VerticalCurveMath.cs is host-independent by design so the K computation
       and AASHTO table lookup behind civil3d_profile check_k_values can be
       exercised here without Civil 3D. BridgeMath.cs supplies unit factors. -->
  <ItemGroup>
    <Compile Include="..\..\Civil3D-MCP-Plugin\VerticalCurveMath.cs" Link="VerticalCurveMath.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\BridgeMath.cs" Link="BridgeMath.cs" />
  </ItemGroup>
</Project>
